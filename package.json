{
  "name": "insta-gen",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "watcher": "tsx -r dotenv/config services/runWatcher.ts",
    "syncthumbs": "tsx -r dotenv/config services/syncThumbs.ts",
    "dev:all": "concurrently \"npm run watcher\" \"npm run dev\"",
    "start:all": "concurrently \"npm run watcher\" \"npm run start\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "next": "16.3.3",
    "range-parser": "^1.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.3.5",
    "@types/react": "19.2.18",
    "baseline-browser-mapping": "^2.10.0",
    "postcss": "^8.5.12",
    "prisma": "^7.8.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.18"
  }
}
